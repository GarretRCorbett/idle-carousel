[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/boss_strip.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/two_step_button.gd" id="2_button"]

[node name="BossStrip" type="PanelContainer"]
