[node name="BossName" type="Label" parent="Margin/Row"]
unique_name_in_owner = true
layout_mode = 2

[node name="Progress" type="Label" parent="Margin/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(56, 0)
layout_mode = 2
theme_override_font_sizes/font_size = 14

[node name="Bar" type="ProgressBar" parent="Margin/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(110, 14)
