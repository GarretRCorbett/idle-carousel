[gd_resource type="Resource" script_class="TierData" format=3]

[ext_resource type="Script" path="res://scripts/tier_data.gd" id="1_script"]
[ext_resource type="Resource" path="res://resources/bosses/ancient_log.tres" id="boss_data"]
[ext_resource type="PackedScene" path="res://scenes/enemies/Leaf.tscn" id="leaf_scene"]
[ext_resource type="PackedScene" path="res://scenes/enemies/Stick.tscn" id="stick_scene"]
[ext_resource type="PackedScene" path="res://scenes/enemies/Rock.tscn" id="rock_scene"]
[ext_resource type="Script" path="res://scripts/wave_profile.gd" id="profile_script"]
[ext_resource type="Script" path="res://scripts/wave_entry.gd" id="entry_script"]

[sub_resource type="Resource" id="leaf_entry"]
script = ExtResource("entry_script")
enemy_scene = ExtResource("leaf_scene")
weight = 66.0
max_per_wave = 0
unlock_after_kills = 0

[sub_resource type="Resource" id="stick_entry"]
script = ExtResource("entry_script")
enemy_scene = ExtResource("stick_scene")
weight = 22.0
max_per_wave = 3
unlock_after_kills = 0

[sub_resource type="Resource" id="rock_entry"]
script = ExtResource("entry_script")
enemy_scene = ExtResource("rock_scene")
weight = 12.0
max_per_wave = 1
unlock_after_kills = 0

[sub_resource type="Resource" id="waves"]
script = ExtResource("profile_script")
interval_seconds = 13.0
min_enemies = 11
max_enemies = 18
directions = 2
entries = Array[ExtResource("entry_script")]([SubResource("leaf_entry"), SubResource("stick_entry"), SubResource("rock_entry")])

[resource]
script = ExtResource("1_script")
tier_id = &"red"
rank = 4
name_key = "TIER_RED"
tint = Color(0.95, 0.25, 0.22, 1)
outline_color = Color(0.160784, 0.137255, 0.2, 1)
health_multiplier = 3.84
speed_multiplier = 1.13
drag_multiplier = 1.0
latch_dps_multiplier = 1.46
gold_multiplier = 4.42
waves = SubResource("waves")
boss = ExtResource("boss_data")
